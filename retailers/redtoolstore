import re

import requests

import config


def fetch(url: str) -> dict:
    match = re.search(r'/(\d{9})(?:\?|$)', url)
    if not match:
        return {"price": None, "name": None, "in_stock": None, "error": "Could not find a 9-digit item ID in this Home Depot URL."}

    item_id = match.group(1)

    if not config.SERPAPI_KEY:
        return {"price": None, "name": None, "in_stock": None, "error": "SERPAPI_KEY is not set (check GitHub secret + workflow env)."}

    params = {
        #"engine": "home_depot_product",
        "product_id": item_id,
        "api_key": config.SERPAPI_KEY,
    }

    response = requests.get("https://serpapi.com/search", params=params, timeout=config.REQUEST_TIMEOUT_SECONDS)

    try:
        data = response.json()
    except ValueError:
        return {"price": None, "name": None, "in_stock": None, "error": f"SerpApi returned non-JSON response (HTTP {response.status_code})."}

    # SerpApi puts a top-level "error" key in the JSON when something's wrong
    # (bad key, out of searches, invalid product_id, etc) - surface it instead
    # of silently returning empty data.
    if "error" in data:
        return {"price": None, "name": None, "in_stock": None, "error": f"SerpApi error: {data['error']}"}

    product = data.get("product_results", {})
    if not product:
        return {"price": None, "name": None, "in_stock": None, "error": "SerpApi returned no product_results for this item ID."}

    price = product.get("price")
    if isinstance(price, str):
        price = price.replace("$", "").replace(",", "").strip()
        try:
            price = float(price)
        except ValueError:
            price = None

    return {
        "price": price,
        "name": product.get("title"),
        "in_stock": product.get("in_stock", False),
        "error": None if price is not None else "SerpApi response had no usable price field.",
    }
